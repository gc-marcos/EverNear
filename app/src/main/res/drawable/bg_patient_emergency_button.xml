<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/patient_emergency_pressed" />
            <corners android:radius="@dimen/patient_emergency_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/patient_emergency" />
            <corners android:radius="@dimen/patient_emergency_radius" />
        </shape>
    </item>
</selector>