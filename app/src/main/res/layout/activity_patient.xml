<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_patient_screen"
    android:paddingStart="@dimen/patient_screen_padding"
    android:paddingEnd="@dimen/patient_screen_padding"
    tools:context=".PatientActivity">

    <TextView
        android:id="@+id/tv_patient_greeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/patient_header_margin_top"
        android:fontFamily="sans"
        android:includeFontPadding="false"
        android:text="@string/patient_greeting_default"
        android:textColor="@color/patient_text_muted"
        android:textSize="@dimen/patient_title_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_debug_geo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Disponível somente em builds de debug; ocupa espaço real quando exibido. -->
    <Button
        android:id="@+id/btn_debug_geo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="@dimen/patient_header_margin_top"
        android:background="@drawable/bg_patient_circle_button"
        android:contentDescription="Abrir ferramentas de debug de localização"
        android:drawableTop="@drawable/ic_debug_location"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="7dp"
        android:text=""
        app:layout_constraintEnd_toStartOf="@id/btn_patient_qr"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_patient_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans"
        android:includeFontPadding="false"
        android:text="@string/patient_title"
        android:textColor="@color/patient_text_primary"
        android:textSize="@dimen/patient_title_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_patient_greeting" />

    <ImageButton
        android:id="@+id/btn_patient_qr"
        android:layout_width="@dimen/patient_qr_size"
        android:layout_height="@dimen/patient_qr_size"
        android:layout_marginTop="@dimen/patient_header_margin_top"
        android:background="@drawable/bg_patient_qr"
        android:contentDescription="@string/patient_qr_description"
        android:padding="@dimen/patient_qr_padding"
        android:src="@drawable/ic_qr_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/patient_monitor_ring"
        android:layout_width="@dimen/patient_ring_size"
        android:layout_height="@dimen/patient_ring_size"
        android:layout_marginTop="@dimen/patient_ring_margin_top"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_patient_title">

        <View
            android:id="@+id/patient_ring_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_patient_ring_outer" />

        <View
            android:id="@+id/patient_ring_middle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/patient_ring_middle_inset"
            android:background="@drawable/bg_patient_ring_middle" />

        <View
            android:id="@+id/patient_ring_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/patient_ring_inner_inset"
            android:background="@drawable/bg_patient_ring_inner" />

        <LinearLayout
            android:id="@+id/patient_ring_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_calibration_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patient_calibrating_title"
                android:textColor="@color/patient_text_secondary"
                android:textSize="@dimen/patient_ring_label_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_calibration_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0%"
                android:textColor="@color/patient_text_primary"
                android:textSize="@dimen/patient_calibration_percent_text_size"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_calibration_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patient_calibrating_subtitle"
                android:textColor="@color/patient_text_muted"
                android:textSize="@dimen/patient_ring_label_text_size"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_bpm_heart"
                android:layout_width="@dimen/patient_heart_size"
                android:layout_height="@dimen/patient_heart_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_patient_heart" />

            <TextView
                android:id="@+id/tv_bpm_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/patient_text_primary"
                android:textSize="@dimen/patient_bpm_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_bpm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patient_bpm_label"
                android:textColor="@color/patient_text_muted"
                android:textSize="@dimen/patient_bpm_label_text_size" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/patient_status_margin_top"
        android:background="@drawable/bg_patient_status"
        android:gravity="center"
        android:paddingStart="@dimen/patient_status_padding_horizontal"
        android:paddingEnd="@dimen/patient_status_padding_horizontal"
        android:paddingTop="@dimen/patient_status_padding_vertical"
        android:paddingBottom="@dimen/patient_status_padding_vertical"
        android:text="@string/patient_status_waiting"
        android:textColor="@color/patient_status_neutral"
        android:textSize="@dimen/patient_status_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/patient_monitor_ring" />

    <LinearLayout
        android:id="@+id/patient_stats"
        android:layout_width="0dp"
        android:layout_height="@dimen/patient_stats_height"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_patient_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/patient_stats_padding"
        android:paddingEnd="@dimen/patient_stats_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_status">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patient_minimum"
                android:textColor="@color/patient_text_muted"
                android:textSize="@dimen/patient_stat_label_text_size" />

            <TextView
                android:id="@+id/tv_minimo_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/patient_stat_value_margin_top"
                android:text="-- bpm"
                android:textColor="@color/patient_stat_min"
                android:textSize="@dimen/patient_stat_value_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/patient_divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patient_maximum"
                android:textColor="@color/patient_text_muted"
                android:textSize="@dimen/patient_stat_label_text_size" />

            <TextView
                android:id="@+id/tv_maximo_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/patient_stat_value_margin_top"
                android:text="-- bpm"
                android:textColor="@color/patient_stat_max"
                android:textSize="@dimen/patient_stat_value_text_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_vinculo"
        android:layout_width="0dp"
        android:layout_height="@dimen/patient_action_button_size"
        android:layout_marginBottom="@dimen/patient_emergency_margin_bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_status_vinculo"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_ver_codigo"
            android:layout_width="@dimen/patient_action_button_size"
            android:layout_height="@dimen/patient_action_button_size"
            android:layout_marginEnd="@dimen/patient_action_button_gap"
            android:background="@drawable/bg_patient_circle_button"
            android:contentDescription="Vincular cuidador e ver código"
            android:drawableTop="@drawable/ic_link_shield"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="9dp"
            android:text=""
            android:drawableTint="@color/patient_link_icon" />

        <Button
            android:id="@+id/btn_calibrar"
            android:layout_width="@dimen/patient_action_button_size"
            android:layout_height="@dimen/patient_action_button_size"
            android:layout_marginEnd="@dimen/patient_action_button_gap"
            android:background="@drawable/bg_patient_circle_button"
            android:contentDescription="Recalibrar limites"
            android:drawableTop="@drawable/ic_recalibrate"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="9dp"
            android:text=""
            android:drawableTint="@color/patient_text_secondary" />

        <Button
            android:id="@+id/btn_emergency"
            android:layout_width="@dimen/patient_action_button_size"
            android:layout_height="@dimen/patient_action_button_size"
            android:background="@drawable/bg_patient_circle_emergency"
            android:contentDescription="Disparar emergência"
            android:drawableTop="@drawable/ic_emergency"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="9dp"
            android:text=""
            android:drawableTint="@color/patient_text_primary" />
    </LinearLayout>

    <!-- IDs preservados para a lógica existente. -->
    <TextView
        android:id="@+id/tv_limites"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>