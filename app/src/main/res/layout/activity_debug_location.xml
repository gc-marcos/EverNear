<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout da tela de Debug de Geolocalização (DebugLocationActivity).

    ATENÇÃO: Este layout é usado SOMENTE em BuildConfig.DEBUG == true.
    A Activity que o infla verifica BuildConfig.DEBUG em onCreate() e
    encerra imediatamente em builds de Release.

    Estrutura de seções:
      1. Cabeçalho de aviso debug
      2. Inputs manuais de lat/lng + botão Enviar
      3. Botões rápidos de simulação
      4. Informações da Zona Segura (lidas do Firestore)
      5. Estado atual: posição simulada, distância e status
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ── 1. Cabeçalho ──────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐛  DEBUG GEOLOCATION"
            android:textColor="#FF9800"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apenas em builds de debug. Simule posições geográficas e teste o geofencing em dispositivos físicos."
            android:textColor="#9AA4B2"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingBottom="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#30363D" />

        <!-- ── 2. Inputs manuais ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCALIZAÇÃO SIMULADA"
            android:textColor="#58A6FF"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_debug_latitude"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Latitude (ex: -23.5505)"
            android:inputType="numberSigned|numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E7681"
            android:textSize="13sp"
            android:background="#161B22"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_debug_longitude"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Longitude (ex: -46.6333)"
            android:inputType="numberSigned|numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E7681"
            android:textSize="13sp"
            android:background="#161B22"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_debug_enviar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Enviar Localização"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F6FEB" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#30363D"
            android:layout_marginTop="12dp" />

        <!-- ── 3. Botões rápidos ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIMULAÇÕES RÁPIDAS"
            android:textColor="#58A6FF"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_debug_dentro"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="✅  Dentro da Área Segura"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2EA043"
            android:layout_marginBottom="6dp" />

        <!-- Grid 2 colunas para botões "fora" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_debug_fora_50"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="⚠ Fora 50 m"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D29922"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_debug_fora_100"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="⚠ Fora 100 m"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D29922" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_debug_fora_300"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🚨 Fora 300 m"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#DA3633"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_debug_fora_1km"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🚨 Fora 1 km"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#DA3633" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#30363D"
            android:layout_marginTop="12dp" />

        <!-- ── 4. Zona Segura (lida do Firestore) ───────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PONTO SEGURO (FIRESTORE)"
            android:textColor="#58A6FF"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_debug_zona_lat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lat:  —"
            android:textColor="#9AA4B2"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_debug_zona_lng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long: —"
            android:textColor="#9AA4B2"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_debug_zona_raio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Raio: —"
            android:textColor="#9AA4B2"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#30363D"
            android:layout_marginTop="12dp" />

        <!-- ── 5. Estado Atual ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESTADO ATUAL"
            android:textColor="#58A6FF"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_debug_sim_lat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lat sim: —"
            android:textColor="#9AA4B2"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_debug_sim_lng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long sim: —"
            android:textColor="#9AA4B2"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_debug_distancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distância: —"
            android:textColor="#9AA4B2"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <!-- Status com destaque visual -->
        <TextView
            android:id="@+id/tv_debug_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: aguardando..."
            android:textColor="#9AA4B2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:background="#161B22"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
