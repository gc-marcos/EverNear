<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/patient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/patient_screen_padding">

        <TextView
            android:id="@+id/tv_welcome_paciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/patient_header_margin_top"
            android:text="Meu Código"
            android:textColor="@color/patient_text_primary"
            android:textSize="@dimen/patient_title_text_size"
            android:textStyle="bold" />

        <!-- QR Code decorativo da área de vinculação. -->
        <FrameLayout
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_patient_ring_outer"
            android:padding="9dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_patient_ring_middle"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_patient_qr"
                    android:contentDescription="Ícone de QR Code"
                    android:padding="10dp"
                    android:src="@drawable/ic_qr_code"
                    android:tint="@color/login_red_medical" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Código de Vinculação"
            android:textColor="@color/patient_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_patient_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_codigo_vinculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="------"
                android:textColor="@color/login_red_medical"
                android:textSize="36sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_share_codigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/login_red_medical"
                android:drawableStart="@android:drawable/ic_menu_share"
                android:drawableTint="@color/patient_text_primary"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="Compartilhar"
                android:textAllCaps="false"
                android:textColor="@color/patient_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Status de cuidadores vinculados. -->
        <LinearLayout
            android:id="@+id/card_status_vinculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_patient_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Vínculo protegido"
                android:src="@drawable/ic_link_shield" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_status_vinculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Compartilhe este código com seu cuidador"
                    android:textColor="@color/patient_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_monitoramento_vinculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Você está sendo monitorado"
                    android:textColor="@color/patient_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>