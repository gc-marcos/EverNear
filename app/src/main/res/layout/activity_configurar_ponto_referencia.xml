<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_caregiver_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_voltar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="‹"
                android:textColor="@color/caregiver_text_primary"
                android:textSize="34sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/tv_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zona segura"
                    android:textColor="@color/caregiver_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Paciente"
                    android:textColor="@color/caregiver_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_zona_ativa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Ativa"
                android:textColor="#24D36B"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_caregiver_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌖  Zona segura"
                android:textColor="@color/caregiver_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Avise quando o paciente sair da área"
                android:textColor="@color/caregiver_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Escolha um endereço ou use sua localização atual."
                android:textColor="@color/caregiver_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_endereco"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_caregiver_pill"
                    android:hint="Rua, número, cidade ou referência"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="@color/caregiver_text_primary"
                    android:textColorHint="@color/caregiver_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_buscar"
                    android:layout_width="54dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_caregiver_button_secondary"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="⌕"
                    android:textColor="@color/caregiver_text_primary"
                    android:textSize="24sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_minha_localizacao"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_caregiver_button_secondary"
                android:gravity="center"
                android:text="⌾  Usar minha localização atual"
                android:textColor="@color/main_caregiver_icon"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_local_selecionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_caregiver_pill"
                android:padding="12dp"
                android:text="Centro selecionado: escolha um endereço ou localização"
                android:textColor="@color/caregiver_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="RAIO DE SEGURANÇA"
                android:textColor="@color/caregiver_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_raio_100"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#10162B"
                    android:text="100 m"
                    android:textColor="@color/caregiver_text_primary"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btn_raio_300"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#10162B"
                    android:text="300 m"
                    android:textColor="@color/caregiver_text_primary"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btn_raio_500"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#10162B"
                    android:text="500 m"
                    android:textColor="@color/caregiver_text_primary"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btn_raio_1000"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#10162B"
                    android:text="1 km"
                    android:textColor="@color/caregiver_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_salvar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_caregiver_button_primary"
                android:enabled="false"
                android:text="Salvar zona segura"
                android:textColor="@color/caregiver_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_remover"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:text="Remover zona segura"
                android:textColor="#FF7188"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>